# Copie para .env e preencha.

# --- Banco (dev local) ------------------------------------------------------
# Suba o Postgres local com:  npx prisma dev --detach --name reservas
# e confira a porta com:      npx prisma dev ls
DATABASE_URL="postgres://postgres:postgres@localhost:51214/reservas?sslmode=disable"
DIRECT_URL="postgres://postgres:postgres@localhost:51214/reservas?sslmode=disable"

# --- Banco (produção / Supabase via Vercel) ---------------------------------
# DATABASE_URL  -> conexão do pooler do Supabase (o site usa esta)
# DIRECT_URL    -> conexão do Session pooler, porta 5432 (migrations; a direta
#                  só aceita IPv6 e o build da Vercel é IPv4)

# --- Auth -------------------------------------------------------------------
# Gere com: npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET=""

# Credenciais do admin criadas pelo seed
ADMIN_USERNAME="admin"
ADMIN_INITIAL_PASSWORD=""

# --- Seed (opcional) --------------------------------------------------------
# SEED_RESTAURANT_NAME="Canto Verde"
# SEED_TOTAL_CAPACITY="40"
# SEED_RESTAURANT_EMAIL="reservas@exemplo.com.br"

# --- E-mail (Resend) --------------------------------------------------------
# Sem a chave, as reservas funcionam normalmente; só o aviso é pulado.
RESEND_API_KEY=""
RESEND_FROM="Reservas <onboarding@resend.dev>"

# Banco descartável usado pelo `prisma migrate dev` (só em desenvolvimento).
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51214/reservas_shadow?sslmode=disable"

# URL pública do site (produção) — usada nos links de e-mail.
# APP_URL="https://reservas.exemplo.com.br"

# Protege a rota de cron dos lembretes (/api/cron/reminders).
CRON_SECRET=""

# --- Avisos no celular (Web Push) ------------------------------------------
# Par de chaves que assina as notificações. Gere uma vez com:
#   npx web-push generate-vapid-keys
# Sem elas, o botão "Avisar neste celular" diz que falta configurar.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contato do remetente (https://... ou mailto:...). Opcional.
# VAPID_SUBJECT="https://canto-verde.vercel.app"
